{
  "name": "d20-software-house",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify": "vite-node scripts/verify-geometry.mjs && vite-node scripts/verify-edges.mjs && vite-node scripts/verify-timeline.mjs",
    "check:browser": "node scripts/check-browser.cjs",
    "check:states": "node scripts/check-states.cjs",
    "check:audio": "node scripts/check-audio.cjs",
    "check:contact": "node scripts/check-contact.cjs"
  },
  "dependencies": {
    "motion": "^12.23.12",
    "nodemailer": "^9.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-node": "^6.0.0"
  }
}
